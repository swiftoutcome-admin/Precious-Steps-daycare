---
layout: layouts/base.njk
pageKey: programs
pagination:
  data: languages
  size: 1
  alias: lang
  # Without this Eleventy puts only the FIRST paginated output into
  # collections, so the Spanish pages would be missing from the sitemap.
  addAllPagesToCollections: true
permalink: "{{ pageKey | localizedUrl(lang.code) }}"
eleventyComputed:
  title: "{{ i18n[lang.code].programs.title }}"
  description: "{{ i18n[lang.code].programs.description }}"
---
{% set t = i18n[lang.code] %}
{% set pg = t.programs %}

<section class="hero">
  <div class="wrap">
    <p class="eyebrow">{{ pg.eyebrow }}</p>
    <h1 class="hero__title">{{ pg.heroTitle }}</h1>
    <p class="hero__lead">{{ pg.heroLead }}</p>
  </div>
</section>

{% for program in programs %}
  {% set pc = t.programContent[program.id] %}
  <section class="section{% if loop.index0 % 2 == 1 %} section--subtle{% endif %}" id="{{ program.id }}">
    <div class="wrap wrap--narrow">
      <h2>{{ pc.name }}</h2>

      <dl class="spec">
        <dt>{{ t.common.ages }}</dt>
        <dd>{{ program.ages }}</dd>
        <dt>{{ t.common.ratio }}</dt>
        <dd>{{ program.ratio }}</dd>
        <dt>{{ t.common.curriculum }}</dt>
        <dd>{{ program.curriculum }}</dd>
      </dl>

      {% if not program.agesConfirmed %}
        <div class="todo">
          <strong>{{ pg.unconfirmedAges }}</strong>
          {{ program.agesNote }}
        </div>
      {% endif %}

      {% if pc.summary %}
        <p>{{ pc.summary }}</p>
      {% else %}
        <div class="todo">
          <strong>{{ t.common.contentNeeded }}</strong>
          {{ program.sourceNote }}
        </div>
      {% endif %}

      {% if pc.schedule %}
        <h3>{{ pg.typicalDay }}</h3>
        <p>{{ pc.schedule }}</p>
      {% endif %}

      {% if pc.bring.length %}
        <h3>{{ pg.whatToBring }}</h3>
        <ul>
          {% for item in pc.bring %}
            <li>{{ item }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </section>
{% endfor %}

<section class="section section--ruled">
  <div class="wrap wrap--narrow">
    <h2>{{ pg.mealsTitle }}</h2>
    <p>{{ pg.mealsP1 }}</p>
    <p>{{ pg.mealsP2 }}</p>

    <h2>{{ pg.tripsTitle }}</h2>
    <p>{{ pg.tripsP1 }}</p>

    <h2>{{ pg.touchTitle }}</h2>
    <p>{{ pg.touchP1 }}</p>
  </div>
</section>

{% include "partials/cta-band.njk" %}

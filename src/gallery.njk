---
layout: layouts/base.njk
pageKey: gallery
pagination:
  data: languages
  size: 1
  alias: lang
  addAllPagesToCollections: true
permalink: "{{ pageKey | localizedUrl(lang.code) }}"
eleventyComputed:
  title: "{{ i18n[lang.code].gallery.title }}"
  description: "{{ i18n[lang.code].gallery.description }}"
---
{% set t = i18n[lang.code] %}
{% set g = t.gallery %}

<section class="hero">
  <div class="wrap">
    <p class="eyebrow">{{ g.eyebrow }}</p>
    <h1 class="hero__title">{{ g.heroTitle }}</h1>
    <p class="hero__lead">{{ g.heroLead }}</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="todo">
      <strong>Temporary stock photography</strong>
      {{ g.stockNotice }}
      <br /><br />
      Replace every file in src/assets/img/gallery/ with the center's own
      photographs before launch, and update the matching alt text under
      imageAlt in BOTH i18n bundles. No photograph showing an identifiable
      child may be published without a signed publicity release on file;
      record each clearance in docs/photo-release-log.md.
    </div>

    {% set shots = [
      { file: "blocks.webp",        alt: t.imageAlt.blocks },
      { file: "shape-sorter.webp",  alt: t.imageAlt.shapeSorter },
      { file: "play-kitchen.webp",  alt: t.imageAlt.playKitchen },
      { file: "toy-bus.webp",       alt: t.imageAlt.toyBus },
      { file: "sandbox.webp",       alt: t.imageAlt.sandbox },
      { file: "water-table.webp",   alt: t.imageAlt.waterTable }
    ] %}

    <ul class="grid grid--3 grid--list">
      {% for shot in shots %}
        <li>
          <figure class="media media--portrait">
            <img
              class="media__img"
              src="/assets/img/gallery/{{ shot.file }}"
              alt="{{ shot.alt }}"
              width="760"
              height="950"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% include "partials/cta-band.njk" %}

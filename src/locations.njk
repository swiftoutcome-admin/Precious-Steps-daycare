---
layout: layouts/base.njk
pageKey: locations
pagination:
  data: languages
  size: 1
  alias: lang
  # Without this Eleventy puts only the FIRST paginated output into
  # collections, so the Spanish pages would be missing from the sitemap.
  addAllPagesToCollections: true
permalink: "{{ pageKey | localizedUrl(lang.code) }}"
eleventyComputed:
  title: "{{ i18n[lang.code].locations.title }}"
  description: "{{ i18n[lang.code].locations.description }}"
---
{% set t = i18n[lang.code] %}
{% set lc = t.locations %}

<section class="hero">
  <div class="wrap">
    <p class="eyebrow">{{ lc.eyebrow }}</p>
    <h1 class="hero__title">{{ lc.heroTitle }}</h1>
    <p class="hero__lead">{{ lc.heroLead }}</p>
  </div>
</section>

{% for location in site.locations %}
  <section class="section{% if loop.index0 % 2 == 1 %} section--subtle{% endif %}" id="{{ location.id }}">
    <div class="wrap wrap--narrow">
      <h2>{{ location.name }}</h2>

      <address>
        {{ location.street }}<br />
        {{ location.city }}, {{ location.state }} {{ location.zip }}
      </address>

      <div class="map map--standalone">
        {% include "partials/location-map.njk" %}
      </div>

      <dl class="spec">
        <dt>{{ t.common.phone }}</dt>
        <dd><a href="tel:{{ location.phone | phoneHref }}">{{ location.phone | phoneDisplay }}</a></dd>
        <dt>{{ t.common.fax }}</dt>
        <dd>{{ location.fax | phoneDisplay }}</dd>
        <dt>{{ t.common.hours }}</dt>
        <dd>{{ location.hours }}{% if location.hoursNote %} {{ location.hoursNote }}{% endif %}</dd>
        <dt>{{ t.common.calendar }}</dt>
        <dd>{{ location.calendar }}</dd>
        <dt>{{ t.common.programsHere }}</dt>
        <dd>
          {% for id in location.programs %}
            {%- for program in programs -%}
              {%- if program.id == id -%}
                <a href="{{ 'programs' | localizedUrl(lang.code) }}#{{ program.id }}">{{ t.programContent[program.id].name }}</a>{% if not loop.last %}, {% endif %}
              {%- endif -%}
            {%- endfor -%}
          {% endfor %}
        </dd>
      </dl>

      {% if not location.programsConfirmed %}
        <div class="todo">
          <strong>{{ t.common.unconfirmed }}</strong>
          {{ lc.unconfirmedPrograms }}
        </div>
      {% endif %}

      {% if not location.addressConfirmed %}
        <div class="todo">
          <strong>{{ lc.unconfirmedAddress }}</strong>
          {{ location.addressNote }}
        </div>
      {% endif %}

      {% if not location.contactPerson %}
        <div class="todo">
          <strong>{{ t.common.contentNeeded }}</strong>
          {{ lc.contactPersonNeeded }}
        </div>
      {% endif %}
    </div>
  </section>
{% endfor %}

<section class="section section--ruled">
  <div class="wrap wrap--narrow">
    <h2>{{ lc.closingsTitle }}</h2>
    <p>{{ site.closuresNote if lang.code == 'en' else site.closuresNoteEs }}</p>
    <ul>
      {% for closure in (site.closures if lang.code == 'en' else site.closuresEs) %}
        <li>{{ closure }}</li>
      {% endfor %}
    </ul>
  </div>
</section>

{% include "partials/cta-band.njk" %}

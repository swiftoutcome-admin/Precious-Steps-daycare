---
layout: layouts/base.njk
pageKey: home
pagination:
  data: languages
  size: 1
  alias: lang
  # Without this Eleventy puts only the FIRST paginated output into
  # collections, so the Spanish pages would be missing from the sitemap.
  addAllPagesToCollections: true
permalink: "{{ pageKey | localizedUrl(lang.code) }}"
eleventyComputed:
  description: "{{ i18n[lang.code].siteDescription }}"
---
{% set t = i18n[lang.code] %}

{% set active = announcements | activeAnnouncements %}
{% if active.length %}
  <div class="announcement">
    <div class="wrap">
      {% for item in active %}
        <p class="announcement__title">{{ item.title }}</p>
        <p>{{ item.body }}</p>
      {% endfor %}
    </div>
  </div>
{% endif %}

{# ---------------------------------------------------------------- Hero #}
<section class="hero hero--split">
  <div class="wrap hero__grid">
    <div class="hero__content">
      <p class="eyebrow">{{ t.home.eyebrow }}</p>
      <h1 class="hero__title">{{ t.tagline }}</h1>
      <p class="hero__lead">{{ t.home.lead }}</p>
      <div class="hero__actions">
        <a class="button button--primary button--lg" href="{{ 'contact' | localizedUrl(lang.code) }}">{{ t.cta.requestTour }}</a>
        <a class="button button--secondary button--lg" href="{{ 'programs' | localizedUrl(lang.code) }}">{{ t.cta.seePrograms }}</a>
      </div>
    </div>

    <div class="hero__media">
      {% set slotSrc = null %}
      {% set slotRatio = "portrait" %}
      {% set slotLabel = t.home.heroImageSlot %}
      {% include "partials/media-slot.njk" %}
    </div>
  </div>
</section>

{# ------------------------------------------------------------ Trust strip #}
<section class="trust">
  <div class="wrap">
    <ul class="trust__list">
      {% for item in site.accreditations %}
        <li class="trust__item">
          <span class="trust__name">{{ item.name }}</span>
          <span class="trust__detail">{{ item.detail }}</span>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{# ------------------------------------------------------- Feature: our story #}
<section class="section">
  <div class="wrap">
    <div class="feature">
      <div class="feature__text">
        <p class="eyebrow">{{ t.home.storyEyebrow }}</p>
        <h2>{{ t.home.storyTitle }}</h2>
        <p>{{ t.home.storyP1 }}</p>
        <p>{{ t.home.storyP2 }}</p>
        <p><a href="{{ 'about' | localizedUrl(lang.code) }}">{{ t.home.storyLink }}</a></p>
      </div>
      <div class="feature__media">
        {% set slotSrc = null %}
        {% set slotRatio = "landscape" %}
        {% set slotLabel = t.home.storyImageSlot %}
        {% include "partials/media-slot.njk" %}
      </div>
    </div>
  </div>
</section>

{# ------------------------------------------------------- Feature: our team #}
<section class="section section--subtle">
  <div class="wrap">
    <div class="feature feature--reverse">
      <div class="feature__text">
        <p class="eyebrow">{{ t.home.teamEyebrow }}</p>
        <h2>{{ t.home.teamTitle }}</h2>
        <p>{{ t.home.teamP1 }}</p>
        <p>{{ t.home.teamP2 }}</p>
        <p><a href="{{ 'about' | localizedUrl(lang.code) }}#our-teachers">{{ t.home.teamLink }}</a></p>
      </div>
      <div class="feature__media">
        {% set slotSrc = null %}
        {% set slotRatio = "landscape" %}
        {% set slotLabel = t.home.teamImageSlot %}
        {% include "partials/media-slot.njk" %}
      </div>
    </div>
  </div>
</section>

{# -------------------------------------------------------------- Programs #}
<section class="section">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">{{ t.home.programsEyebrow }}</p>
      <h2>{{ t.home.programsTitle }}</h2>
      <p class="section__lead">{{ t.home.programsLead }}</p>
    </div>

    <ul class="grid grid--3 grid--list">
      {% for program in programs %}
        {% set pc = t.programContent[program.id] %}
        <li>
          <article class="card">
            <h3 class="card__title">{{ pc.name }}</h3>
            <p class="card__meta">{{ program.ages }} &middot; {{ program.ratio }}</p>
            <div class="card__body">
              {% if pc.summary %}
                <p>{{ pc.summary }}</p>
              {% else %}
                <div class="todo">
                  <strong>{{ t.common.contentNeeded }}</strong>
                  {{ program.sourceNote }}
                </div>
              {% endif %}
            </div>
            <p class="card__link">
              <a href="{{ 'programs' | localizedUrl(lang.code) }}#{{ program.id }}">{{ t.home.programsCardLink }} {{ pc.name }}</a>
            </p>
          </article>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{# --------------------------------------------------------- Feature: meals #}
<section class="section section--subtle">
  <div class="wrap">
    <div class="feature">
      <div class="feature__text">
        <p class="eyebrow">{{ t.home.mealsEyebrow }}</p>
        <h2>{{ t.home.mealsTitle }}</h2>
        <p>{{ t.home.mealsP1 }}</p>
        <p>{{ t.home.mealsP2 }}</p>
      </div>
      <div class="feature__media">
        {% set slotSrc = null %}
        {% set slotRatio = "landscape" %}
        {% set slotLabel = t.home.mealsImageSlot %}
        {% include "partials/media-slot.njk" %}
      </div>
    </div>
  </div>
</section>

{# -------------------------------------------------------- Photo divider #}
<section class="divider">
  {% set slotSrc = null %}
  {% set slotRatio = "wide" %}
  {% set slotLabel = t.home.dividerImageSlot %}
  {% include "partials/media-slot.njk" %}
</section>

{# ------------------------------------------------------ Locations + maps #}
<section class="section">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">{{ t.home.visitEyebrow }}</p>
      <h2>{{ t.home.visitTitle }}</h2>
      <p class="section__lead">{{ t.home.visitLead }}</p>
    </div>

    <div class="grid grid--2">
      {% for location in site.locations %}
        <article class="location">
          {% include "partials/location-map.njk" %}

          <div class="location__body">
            <h3 class="location__name">{{ location.name }}</h3>
            <address class="location__address">
              {{ location.street }}<br />
              {{ location.city }}, {{ location.state }} {{ location.zip }}
            </address>
            <dl class="spec">
              <dt>{{ t.common.phone }}</dt>
              <dd><a href="tel:{{ location.phone | phoneHref }}">{{ location.phone | phoneDisplay }}</a></dd>
              <dt>{{ t.common.hours }}</dt>
              <dd>{{ location.hours }}</dd>
              <dt>{{ t.common.calendar }}</dt>
              <dd>{{ location.calendar }}</dd>
            </dl>
            {% if not location.addressConfirmed or not location.programsConfirmed %}
              <div class="todo">
                <strong>{{ t.common.unconfirmed }}</strong>
                Address, hours, calendar or program mix for this location is
                pending client confirmation. See CONTENT-STATUS.md.
              </div>
            {% endif %}
            <p>
              <a href="{{ 'locations' | localizedUrl(lang.code) }}#{{ location.id }}">{{ t.home.visitMoreAbout }} {{ location.name }}</a>
            </p>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{# ------------------------------------------------------------ Testimonials #}
<section class="section section--subtle">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">{{ t.home.familiesEyebrow }}</p>
      <h2>{{ t.home.familiesTitle }}</h2>
    </div>
    <div class="todo">
      <strong>{{ t.common.contentNeeded }}</strong>
      The client is approaching parents for testimonials. Each one needs the
      parent's written permission to publish, along with a first name or
      initials. Until then this section stays out of the launch build.
    </div>
  </div>
</section>

{% include "partials/cta-band.njk" %}

---
layout: layouts/base.njk
pageKey: home
pagination:
  data: languages
  size: 1
  alias: lang
  # Without this Eleventy puts only the FIRST paginated output into
  # collections, so the Spanish pages would be missing from the sitemap.
  addAllPagesToCollections: true
permalink: "{{ pageKey | localizedUrl(lang.code) }}"
eleventyComputed:
  description: "{{ i18n[lang.code].siteDescription }}"
---
{% set t = i18n[lang.code] %}

{% set active = announcements | activeAnnouncements %}
{% if active.length %}
  <div class="announcement">
    <div class="wrap">
      {% for item in active %}
        <p class="announcement__title">{{ item.title }}</p>
        <p>{{ item.body }}</p>
      {% endfor %}
    </div>
  </div>
{% endif %}

{# ---------------------------------------------------------------- Hero #}
<section class="home-hero" aria-labelledby="home-title">
  <div class="home-hero__inner">
    <div class="home-hero__copy">
      <p class="pill">
        <svg class="icon" aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
        {{ t.home.eyebrow }}
      </p>
      <h1 class="home-hero__title" id="home-title">{{ t.tagline }}</h1>
      <p class="home-hero__lead">{{ t.home.lead }}</p>
      <div class="home-hero__actions">
        <a class="button button--primary button--lg" href="{{ 'contact' | localizedUrl(lang.code) }}">{{ t.cta.requestTour }}</a>
        <a class="button button--secondary button--lg" href="{{ 'programs' | localizedUrl(lang.code) }}">{{ t.cta.seePrograms }}</a>
      </div>
    </div>

    <figure class="home-hero__media">
      <img
        class="home-hero__img"
        src="/assets/img/programs/shape-sorter.webp"
        alt="{{ t.imageAlt.shapeSorter }}"
        width="880"
        height="1100"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  </div>
</section>

{# ------------------------------------------------------- Front desk #}
{# Hours, phones and directions for both buildings, in the first screen.
   This is what most visitors came for, so it sits above everything else. #}
<section class="desk" id="visit" aria-labelledby="desk-title">
  <div class="desk__inner">
    <div class="desk__head">
      <p class="eyebrow">{{ t.home.visitEyebrow }}</p>
      <h2 class="desk__title" id="desk-title">{{ t.home.visitTitle }}</h2>
      <p class="desk__lead">{{ t.home.visitLead }}</p>
    </div>

    <ul class="desk__list">
      {% for location in site.locations %}
        <li class="ticket">
          <h3 class="ticket__name">{{ location.name }}</h3>
          <address class="ticket__address">
            {{ location.street }}<br />
            {{ location.city }}, {{ location.state }} {{ location.zip }}
          </address>

          <dl class="ticket__facts">
            <div class="ticket__fact">
              <dt>{{ t.common.hours }}</dt>
              <dd>{{ location.hours if lang.code == 'en' else location.hoursEs }}</dd>
            </div>
            {% if location.contactPerson %}
              <div class="ticket__fact">
                <dt>{{ t.common.askFor }}</dt>
                <dd>{{ location.contactPerson }}</dd>
              </div>
            {% endif %}
            <div class="ticket__fact">
              <dt>{{ t.common.programsHere }}</dt>
              <dd>
                <ul class="chips">
                  {% for pid in location.programs %}
                    <li class="chip">{{ t.programContent[pid].name }}</li>
                  {% endfor %}
                </ul>
              </dd>
            </div>
          </dl>

          {% if not location.addressConfirmed or not location.programsConfirmed %}
            <div class="todo">
              <strong>{{ t.common.unconfirmed }}</strong>
              Address, hours, calendar or program mix for this location is
              pending client confirmation. See CONTENT-STATUS.md.
            </div>
          {% endif %}

          <div class="ticket__actions">
            <a class="ticket__call" href="tel:{{ location.phone | phoneHref }}">
              <svg class="icon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
              <span class="visually-hidden">{{ t.common.phone }}:</span>
              {{ location.phone | phoneDisplay }}
            </a>
            <a class="ticket__link" href="{{ location | mapUrl }}">{{ t.cta.directions }} {{ location.name }}</a>
            <a class="ticket__link" href="{{ 'locations' | localizedUrl(lang.code) }}#{{ location.id }}">{{ t.home.visitMoreAbout }} {{ location.name }}</a>
          </div>
        </li>
      {% endfor %}
    </ul>

    <ul class="assure">
      {% for item in site.accreditations %}
        <li class="assure__item">
          <svg class="assure__icon" aria-hidden="true" viewBox="0 0 24 24" width="28" height="28"><path d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5zm-1.2 14.2-3.5-3.5 1.4-1.4 2.1 2.1 4.9-4.9 1.4 1.4z"/></svg>
          <span class="assure__name">{{ item.name }}</span>
          <span class="assure__detail">{{ item.detail }}</span>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{# ---------------------------------------------- Programmes: the staircase #}
{# Five classrooms laid out as steps, youngest to oldest, each riser one
   step taller. The brand is Precious Steps; this is where it shows. #}
<section class="stairs-section" aria-labelledby="programs-title">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">{{ t.home.programsEyebrow }}</p>
      <h2 id="programs-title">{{ t.home.programsTitle }}</h2>
      <p class="section-head__lead">{{ t.home.programsLead }}</p>
    </div>

    <ol class="stairs" data-stairs>
      {% for program in programs %}
        {% set pc = t.programContent[program.id] %}
        <li class="stair stair--{{ loop.index }}">
          <article class="stair__card">
            <h3 class="stair__name">{{ pc.name }}</h3>
            <p class="stair__ratio"><span class="visually-hidden">{{ t.common.ratio }}:</span> {{ program.ratio }}</p>
            {% if pc.summary %}
              <p class="stair__summary">{{ pc.summary }}</p>
            {% else %}
              <div class="todo">
                <strong>{{ t.common.contentNeeded }}</strong>
                {{ program.sourceNote }}
              </div>
            {% endif %}
            <a class="stair__link" href="{{ 'programs' | localizedUrl(lang.code) }}#{{ program.id }}">{{ t.home.programsCardLink }} {{ pc.name }}</a>
          </article>
          <div class="stair__riser">
            <svg class="stair__print" aria-hidden="true" focusable="false" width="24" height="48"><use href="#print"></use></svg>
            <p class="stair__ages"><span class="visually-hidden">{{ t.common.ages }}:</span> {{ program.ages if lang.code == 'en' else program.agesEs }}</p>
          </div>
        </li>
      {% endfor %}
    </ol>
  </div>
</section>

{# ------------------------------------------------ Story + teachers (navy) #}
<section class="story" aria-labelledby="story-title">
  <div class="story__inner">
    <div class="story__block story__block--story reveal">
      <p class="since-pill">{{ t.home.storyEyebrow }}</p>
      <h2 id="story-title">{{ t.home.storyTitle }}</h2>
      <p>{{ t.home.storyP1 }}</p>
      <p>{{ t.home.storyP2 }}</p>
      <p><a class="link-on-navy" href="{{ 'about' | localizedUrl(lang.code) }}">{{ t.home.storyLink }}</a></p>
    </div>
    <figure class="story__photo story__photo--a reveal">
      <img src="/assets/img/programs/toy-bus.webp" alt="{{ t.imageAlt.toyBus }}" width="1086" height="724" loading="lazy" decoding="async" />
    </figure>
    <figure class="story__photo story__photo--b reveal">
      <img src="/assets/img/programs/blocks.webp" alt="{{ t.imageAlt.blocks }}" width="1086" height="724" loading="lazy" decoding="async" />
    </figure>
    <div class="story__block story__block--team reveal">
      <p class="eyebrow eyebrow--on-navy">{{ t.home.teamEyebrow }}</p>
      <h2>{{ t.home.teamTitle }}</h2>
      <p>{{ t.home.teamP1 }}</p>
      <p>{{ t.home.teamP2 }}</p>
      <p><a class="link-on-navy" href="{{ 'about' | localizedUrl(lang.code) }}#our-teachers">{{ t.home.teamLink }}</a></p>
    </div>
  </div>
</section>

{# ----------------------------------------------------------------- Meals #}
<section class="meals" aria-labelledby="meals-title">
  <div class="meals__panel reveal">
    <figure class="meals__photo">
      <img src="/assets/img/programs/play-kitchen.webp" alt="{{ t.imageAlt.playKitchen }}" width="1086" height="724" loading="lazy" decoding="async" />
    </figure>
    <div class="meals__copy">
      <p class="eyebrow">{{ t.home.mealsEyebrow }}</p>
      <h2 id="meals-title">{{ t.home.mealsTitle }}</h2>
      <p>{{ t.home.mealsP1 }}</p>
      <p>{{ t.home.mealsP2 }}</p>
    </div>
  </div>
</section>

{# ------------------------------------------------------------ Photo band #}
<figure class="band reveal">
  <img src="/assets/img/programs/sandbox-wide.webp" alt="{{ t.imageAlt.sandbox }}" width="1086" height="475" loading="lazy" decoding="async" />
</figure>

{# Testimonials return here once the client has parents' written
   permission to publish (CONTENT-STATUS.md item 20). The heading strings
   are kept in both language files as home.familiesEyebrow and
   home.familiesTitle. #}

{% include "partials/cta-band.njk" %}

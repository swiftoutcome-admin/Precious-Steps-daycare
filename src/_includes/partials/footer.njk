{#
  Footer. It stays on a light ground on purpose: the logo's "Precious"
  lettering is Deep Navy and would disappear on a navy footer, and the
  artwork may not be recoloured.
#}
<footer class="footer">
  <div class="footer__inner">
    <div class="footer__brand">
      <img
        class="footer__logo"
        src="/assets/img/brand/logo-horizontal.webp"
        alt="{{ site.name }}"
        width="900"
        height="220"
        loading="lazy"
        decoding="async"
      />
      <p class="footer__tagline">{{ t.tagline }}</p>
      <p class="footer__since">{{ t.common.servingSince }} {{ site.foundedYear }}.</p>
    </div>

    {% for location in site.locations %}
      <div class="footer__col">
        <h2 class="footer__heading">{{ location.name }}</h2>
        <address class="footer__address">
          {{ location.street }}<br />
          {{ location.city }}, {{ location.state }} {{ location.zip }}
        </address>
        <p class="footer__phone"><a href="tel:{{ location.phone | phoneHref }}">{{ location.phone | phoneDisplay }}</a></p>
        <p class="footer__hours">{{ location.hours if lang.code == 'en' else location.hoursEs }}</p>
      </div>
    {% endfor %}

    <div class="footer__col">
      <h2 class="footer__heading">{{ t.common.contactHeading }}</h2>
      <p class="footer__email">
        <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>
      </p>
      <nav aria-label="{{ t.nav.footerLabel }}">
        <ul class="footer__links">
          <li><a href="{{ 'programs' | localizedUrl(lang.code) }}">{{ t.nav.programs }}</a></li>
          <li><a href="{{ 'enrollment' | localizedUrl(lang.code) }}">{{ t.nav.enrollment }}</a></li>
          <li><a href="{{ 'contact' | localizedUrl(lang.code) }}">{{ t.cta.requestTour }}</a></li>
          <li><a href="{{ 'privacy' | localizedUrl(lang.code) }}">{{ t.nav.privacy }}</a></li>
        </ul>
      </nav>
    </div>
  </div>

  <div class="footer__bar">
    <p class="footer__legal">
      &copy; {{ "" | year }} {{ site.legalName | period }} {{ t.common.allRights }}
    </p>
    <p class="footer__legal">
      {{ t.common.licensedBy }}
    </p>
  </div>
</footer>

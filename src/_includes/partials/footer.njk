<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__col">
      <p class="site-footer__name">{{ site.name }}</p>
      <p class="site-footer__tagline">{{ t.tagline }}</p>
      <p class="site-footer__since">{{ t.common.servingSince }} {{ site.foundedYear }}.</p>
    </div>

    {% for location in site.locations %}
      <div class="site-footer__col">
        <h2 class="site-footer__heading">{{ location.name }}</h2>
        <address>
          {{ location.street }}<br />
          {{ location.city }}, {{ location.state }} {{ location.zip }}<br />
          <a href="tel:{{ location.phone | phoneHref }}">{{ location.phone | phoneDisplay }}</a>
        </address>
        <p class="site-footer__hours">{{ location.hours }}</p>
      </div>
    {% endfor %}

    <div class="site-footer__col">
      <h2 class="site-footer__heading">{{ t.common.contactHeading }}</h2>
      <p>
        <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>
      </p>
      <nav aria-label="{{ t.nav.footerLabel }}">
        <ul class="site-footer__links">
          <li><a href="{{ 'programs' | localizedUrl(lang.code) }}">{{ t.nav.programs }}</a></li>
          <li><a href="{{ 'enrollment' | localizedUrl(lang.code) }}">{{ t.nav.enrollment }}</a></li>
          <li><a href="{{ 'contact' | localizedUrl(lang.code) }}">{{ t.cta.requestTour }}</a></li>
          <li><a href="{{ 'privacy' | localizedUrl(lang.code) }}">{{ t.nav.privacy }}</a></li>
        </ul>
      </nav>
    </div>
  </div>

  <div class="site-footer__bar">
    <p class="site-footer__legal">
      &copy; {{ "" | year }} {{ site.legalName }}. {{ t.common.allRights }}
    </p>
    <p class="site-footer__accred">
      {{ t.common.licensedBy }}
    </p>
  </div>
</footer>

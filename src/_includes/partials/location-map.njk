{#
  Embedded map for one location.

  Accessibility notes:
  - The iframe carries a title, which screen readers announce in place of
    the frame contents.
  - A plain text address and a directions link sit outside the frame, so the
    information is reachable without loading or interacting with the map.
  - loading="lazy" keeps the Google request off the critical path.
#}
<div class="map">
  <iframe
    class="map__frame"
    src="{{ location | mapEmbedUrl }}"
    title="Map showing {{ site.name }} at {{ location.street }}, {{ location.city }}, {{ location.state }}"
    width="600"
    height="400"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
  ></iframe>
  <p class="map__caption">
    <a href="{{ location | mapUrl }}">Get directions to {{ location.name }}</a>
  </p>
</div>

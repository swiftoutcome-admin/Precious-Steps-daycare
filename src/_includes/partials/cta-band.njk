<section class="cta-band pattern-bg">
  <div class="cta-band__inner">
    <h2 class="cta-band__title">{{ t.cta.bandTitle }}</h2>
    <p class="cta-band__text">
      {{ t.cta.bandText }} {{ site.contact.responseTime if lang.code == 'en' else site.contact.responseTimeEs }}
    </p>
    <a class="button button--primary button--lg" href="{{ 'contact' | localizedUrl(lang.code) }}">
      {{ t.cta.requestTour }}
    </a>
  </div>
</section>

{#
  Site header, two tiers.

  The thin navy bar carries what a parent most often came for, both
  phone numbers, plus the language switch. Moving the switch up here is
  what lets the main row hold the logo, six links and the tour button on
  one line in Spanish, whose labels run about 40px longer than English.
  Below the width where that row fits, the main row collapses to the
  logo and a Menu button, and the phones move to the bottom call bar.
#}
<header class="masthead">
  <div class="topbar">
    <div class="topbar__inner">
      <ul class="topbar__phones">
        {% for location in site.locations %}
          <li>
            <span class="topbar__place">{{ location.name }}</span>
            <a class="topbar__phone" href="tel:{{ location.phone | phoneHref }}">{{ location.phone | phoneDisplay }}</a>
          </li>
        {% endfor %}
      </ul>

      {#
        Language toggle.

        Plain links, not a scripted switch, so it works with JavaScript off
        and so each language version has a real crawlable URL. The current
        language carries aria-current, and each link carries hreflang and
        lang so a screen reader announces "Español" in Spanish rather than
        reading it with an English voice.
      #}
      <nav class="langs" aria-label="{{ t.nav.languageLabel }}">
        <ul class="langs__list">
          {# Pages outside the paginated set fall back to each language's
             homepage rather than linking to a page that does not exist. #}
          {% set switchKey = pageKey or "home" %}
          {% for l in languages %}
            <li>
              <a
                class="langs__link"
                href="{{ switchKey | localizedUrl(l.code) }}"
                hreflang="{{ l.htmlLang }}"
                lang="{{ l.htmlLang }}"
                {% if l.code == lang.code %}aria-current="true"{% endif %}
              >{{ l.label }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    </div>
  </div>

  <div class="mainbar">
    <div class="mainbar__inner">
      {#
        The client's approved logo artwork, unaltered. The brand standards
        say to use the original rather than recreate it. It is transparent
        and always sits on white. Served at three times its largest display
        size; width and height are declared so the header does not reflow.
        The logo reads "Precious Steps Child Care Center", so the alt text
        is the name alone.
      #}
      <a class="mainbar__brand" href="{{ 'home' | localizedUrl(lang.code) }}">
        <img
          class="mainbar__logo"
          src="/assets/img/brand/logo-horizontal.webp"
          alt="{{ site.name }}"
          width="900"
          height="220"
          decoding="async"
        />
      </a>

      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="primary-nav"
        data-nav-toggle
      >
        <span class="nav-toggle__icon" aria-hidden="true"><span></span></span>
        <span class="nav-toggle__label">{{ t.nav.menu }}</span>
      </button>

      <nav class="mainnav" id="primary-nav" aria-label="{{ t.nav.primaryLabel }}">
        <ul class="mainnav__list">
          {% set navKeys = ["about", "programs", "locations", "enrollment", "gallery", "contact"] %}
          {% for key in navKeys %}
            {% set href = key | localizedUrl(lang.code) %}
            <li>
              <a
                class="mainnav__link"
                href="{{ href }}"
                {% if page.url == href %}aria-current="page"{% endif %}
              >{{ t.nav[key] }}</a>
            </li>
          {% endfor %}
        </ul>

        <a class="button button--primary mainnav__cta" href="{{ 'contact' | localizedUrl(lang.code) }}">
          {{ t.cta.requestTour }}
        </a>
      </nav>
    </div>
  </div>
</header>

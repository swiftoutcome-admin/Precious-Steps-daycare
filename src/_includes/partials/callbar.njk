{#
  Mobile action bar, fixed to the bottom of small screens.

  The two things a parent on a phone most often wants, calling and
  booking a tour, stay one thumb away on every page. "Call us" is a native
  <details> element, so the sheet of both numbers opens with JavaScript
  off and is keyboard and screen reader operable without any ARIA work.
  Hidden at widths where the header's phone bar is visible.
#}
<div class="callbar">
  <details class="callbar__call">
    <summary class="callbar__button callbar__button--call">
      <svg class="icon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
      <span>{{ t.cta.call }}</span>
    </summary>
    <ul class="callbar__sheet">
      {% for location in site.locations %}
        <li>
          <a class="callbar__number" href="tel:{{ location.phone | phoneHref }}">
            <span class="callbar__place">{{ location.name }}</span>
            <span class="callbar__digits">{{ location.phone | phoneDisplay }}</span>
          </a>
        </li>
      {% endfor %}
    </ul>
  </details>
  <a class="callbar__button callbar__button--tour" href="{{ 'contact' | localizedUrl(lang.code) }}">{{ t.cta.requestTour }}</a>
</div>

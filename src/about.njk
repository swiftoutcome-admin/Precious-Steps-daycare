---
layout: layouts/base.njk
pageKey: about
pagination:
  data: languages
  size: 1
  alias: lang
  # Without this Eleventy puts only the FIRST paginated output into
  # collections, so the Spanish pages would be missing from the sitemap.
  addAllPagesToCollections: true
permalink: "{{ pageKey | localizedUrl(lang.code) }}"
eleventyComputed:
  title: "{{ i18n[lang.code].about.title }}"
  description: "{{ i18n[lang.code].about.description }}"
---
{% set t = i18n[lang.code] %}
{% set a = t.about %}

<section class="hero">
  <div class="wrap">
    <p class="eyebrow">{{ a.eyebrow }}</p>
    <h1 class="hero__title">{{ a.heroTitle }}</h1>
    <p class="hero__lead">{{ a.heroLead }}</p>
  </div>
</section>

<section class="section">
  <div class="wrap wrap--narrow">
    <h2>{{ a.storyTitle }}</h2>
    <p>{{ a.storyP1 }}</p>
    <p>{{ a.storyP2 }}</p>
    <p>{{ a.storyP3 }}</p>
  </div>
</section>

<section class="section section--subtle">
  <div class="wrap wrap--narrow">
    <h2>{{ a.philosophyTitle }}</h2>
    <blockquote>
      <p>{{ a.philosophyQuote }}</p>
    </blockquote>
    <p>{{ a.philosophyP1 }}</p>
    <p>{{ a.philosophyP2 }}</p>
  </div>
</section>

<section class="section">
  <div class="wrap wrap--narrow">
    <h2>{{ a.antibiasTitle }}</h2>
    <p>{{ a.antibiasP1 }}</p>
  </div>
</section>

<section class="section section--ruled">
  <div class="wrap wrap--narrow">
    <h2>{{ a.directorTitle }}</h2>
    <div class="todo">
      <strong>Draft pending client review</strong>
      {{ a.directorTodo }}
    </div>
    <p>{{ a.directorP1 }}</p>
    <p>{{ a.directorP2 }}</p>
    <p>{{ a.directorP3 }}</p>
  </div>
</section>

<section class="section section--subtle" id="our-teachers">
  <div class="wrap wrap--narrow">
    <h2>{{ a.teachersTitle }}</h2>
    <p>{{ a.teachersIntro }}</p>
    <dl class="spec">
      <dt>{{ a.teachersLeadLabel }}</dt>
      <dd>{{ a.teachersLeadDetail }}</dd>
      <dt>{{ a.teachersAssocLabel }}</dt>
      <dd>{{ a.teachersAssocDetail }}</dd>
      <dt>{{ a.teachersInfantLabel }}</dt>
      <dd>{{ a.teachersInfantDetail }}</dd>
    </dl>
    <p>{{ a.teachersOutro }}</p>
    <div class="todo">
      <strong>{{ t.common.contentNeeded }}</strong>
      {{ a.teachersTodo }}
    </div>
  </div>
</section>

{% include "partials/cta-band.njk" %}

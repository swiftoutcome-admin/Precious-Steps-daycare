---
layout: layouts/base.njk
pageKey: enrollment
pagination:
  data: languages
  size: 1
  alias: lang
  # Without this Eleventy puts only the FIRST paginated output into
  # collections, so the Spanish pages would be missing from the sitemap.
  addAllPagesToCollections: true
permalink: "{{ pageKey | localizedUrl(lang.code) }}"
eleventyComputed:
  title: "{{ i18n[lang.code].enrollment.title }}"
  description: "{{ i18n[lang.code].enrollment.description }}"
---
{% set t = i18n[lang.code] %}
{% set e = t.enrollment %}

<section class="hero">
  <div class="wrap">
    <p class="eyebrow">{{ e.eyebrow }}</p>
    <h1 class="hero__title">{{ e.heroTitle }}</h1>
    <p class="hero__lead">{{ e.heroLead }}</p>
  </div>
</section>

<section class="section">
  <div class="wrap wrap--narrow">
    <h2>{{ e.stepByStep }}</h2>
    <ol class="steps">
      {% for step in e.steps %}
        <li>
          <p class="steps__title">{{ step.title }}</p>
          <p>{{ step.detail }}</p>
        </li>
      {% endfor %}
    </ol>
  </div>
</section>

<section class="section section--subtle">
  <div class="wrap wrap--narrow">
    <h2>{{ e.documentsTitle }}</h2>
    <ul>
      {% for doc in e.documents %}
        <li>{{ doc }}</li>
      {% endfor %}
    </ul>
    <p>{{ e.documentsNote }}</p>
    <div class="todo">
      <strong>Decision needed</strong>
      {{ enrollment.publishApplicationPdfNote }}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap wrap--narrow">
    <h2>{{ e.tuitionTitle }}</h2>
    <p>{{ e.pricingMessage }}</p>

    <h2>{{ e.subsidiesTitle }}</h2>
    <p>{{ e.subsidiesMessage }} {{ e.subsidiesExtra }}</p>

    <h2>{{ e.availabilityTitle }}</h2>
    <p>{{ e.openingsStatus }}</p>

    <h2>{{ e.toursTitle }}</h2>
    <p>{{ e.openHouse }}</p>
  </div>
</section>

<section class="section section--subtle">
  <div class="wrap wrap--narrow">
    <h2>{{ e.safetyTitle }}</h2>
    <p>{{ e.safetyP1 }}</p>
    <p>{{ e.safetyP2 }}</p>
    <div class="todo">
      <strong>Awaiting file</strong>
      Link the current Parent Handbook PDF here once the client sends the
      revised version. Place it in src/assets/docs/. Do not restate handbook
      policy text on the site: summarize and link, so the handbook stays the
      single source of truth. A Spanish handbook, if one exists, should be
      linked from the Spanish page.
    </div>
  </div>
</section>

<section class="section section--ruled">
  <div class="wrap wrap--narrow">
    <h2>{{ e.faqTitle }}</h2>
    {% for item in t.faq %}
      {% if item.a %}
        <details class="faq__item">
          <summary>{{ item.q }}</summary>
          <p>{{ item.a }}</p>
        </details>
      {% else %}
        <div class="todo">
          <strong>Answer needed: {{ item.q }}</strong>
          Summarize the handbook's Healthy Child Policy in plain language and
          link the current handbook PDF. Do not reproduce the full exclusion
          list on the site.
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% include "partials/cta-band.njk" %}

---
layout: layouts/base.njk
pageKey: privacy
pagination:
  data: languages
  size: 1
  alias: lang
  # Without this Eleventy puts only the FIRST paginated output into
  # collections, so the Spanish pages would be missing from the sitemap.
  addAllPagesToCollections: true
permalink: "{{ pageKey | localizedUrl(lang.code) }}"
eleventyComputed:
  title: "{{ i18n[lang.code].privacy.title }}"
  description: "{{ i18n[lang.code].privacy.description }}"
---
{% set t = i18n[lang.code] %}
{% set pv = t.privacy %}

<section class="hero">
  <div class="wrap wrap--narrow">
    <h1 class="hero__title">{{ pv.heroTitle }}</h1>
    <p class="hero__lead">{{ pv.heroLead }}</p>
  </div>
</section>

<section class="section">
  <div class="wrap wrap--narrow">
    <div class="todo">
      <strong>Legal review recommended</strong>
      {{ pv.reviewTodo }}
    </div>

    <h2>{{ pv.scopeTitle }}</h2>
    <p>{{ pv.scopeBody }}</p>

    <h2>{{ pv.collectTitle }}</h2>
    <p>{{ pv.collectP1 }}</p>
    <p>{{ pv.collectP2 }}</p>

    <h2>{{ pv.useTitle }}</h2>
    <p>{{ pv.useBody }}</p>

    <h2>{{ pv.whereTitle }}</h2>
    <p>{{ pv.whereBody }}</p>

    <h2>{{ pv.cookiesTitle }}</h2>
    <p>{{ pv.cookiesP1 }}</p>
    <p>
      {{ pv.cookiesP2Before }}
      <a href="https://policies.google.com/privacy">{{ pv.cookiesP2Link }}</a>{{ pv.cookiesP2After }}
    </p>

    <h2>{{ pv.childrenTitle }}</h2>
    <p>{{ pv.childrenBody }}</p>

    <h2>{{ pv.photosTitle }}</h2>
    <p>{{ pv.photosBody }}</p>

    <h2>{{ pv.contactTitle }}</h2>
    <p>
      {{ pv.contactBefore }}
      <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>
      {{ pv.contactAfter }}
    </p>
  </div>
</section>
